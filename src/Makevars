CXX_STD = CXX17
# -DNOCURL builds vendored libBigWig for local files only (no libcurl dependency).
PKG_CPPFLAGS = -DNOCURL
PKG_CXXFLAGS = $(SHLIB_OPENMP_CXXFLAGS)
# The vendored libBigWig writer uses OpenMP for parallel block compression.
PKG_CFLAGS = $(SHLIB_OPENMP_CFLAGS)
PKG_LIBS = -lz $(SHLIB_OPENMP_CXXFLAGS)

# Explicit object list so the vendored libBigWig sources in src/libBigWig/ are
# compiled and linked (R only auto-globs the top level of src/).
OBJECTS = bamscale.o RcppExports.o xstringset_build.o \
	libBigWig/bwRead.o libBigWig/bwStats.o libBigWig/bwValues.o \
	libBigWig/bwWrite.o libBigWig/io.o
